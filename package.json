{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api \"npm run dev -w @portfolio/web\" \"npm run dev -w @portfolio/api\"",
    "dev:web": "npm run dev -w @portfolio/web",
    "dev:api": "npm run dev -w @portfolio/api",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspaces",
    "start": "npm run start -w @portfolio/api"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "~5.9.3"
  }
}
