[Unit]
Description=Portfolio (API, rendu des pages et PDF)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=portfolio
Group=portfolio
WorkingDirectory=/opt/portfolio/app/apps/api
EnvironmentFile=/etc/portfolio/portfolio.env
# Clé de l'API Claude (traduction IA de l'admin) : fichier root 600, jamais dans portfolio.env.
# systemd la copie dans un dossier privé au service ($CREDENTIALS_DIRECTORY). Sans fichier,
# SetCredential fournit une valeur vide et la fonctionnalité reste désactivée.
LoadCredential=anthropic-api-key:/etc/portfolio/anthropic-api-key
SetCredential=anthropic-api-key:
ExecStart=/usr/bin/node dist/server.js
Restart=on-failure
RestartSec=3

# Seul le dossier de la base est accessible en écriture.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/portfolio
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
