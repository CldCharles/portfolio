# Configuration de production, copiée vers /etc/portfolio/portfolio.env par setup.sh.
# Les valeurs contenant des espaces restent entre guillemets (systemd et bash les lisent).
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
# Origine publique exacte, en HTTPS et sans slash final.
PUBLIC_ORIGIN=https://__DOMAIN__
# Caddy tourne sur la même machine : seul le proxy local est de confiance.
TRUST_PROXY=loopback
DATABASE_PATH=/var/lib/portfolio/portfolio.sqlite
# Informations affichées dans la notice de confidentialité.
PUBLIC_HOST_NAME="Amazon Web Services (Amazon Lightsail)"
PUBLIC_HOST_COUNTRY="Corée du Sud (Séoul)"
PUBLIC_HOST_LOG_RETENTION="Journaux techniques du serveur conservés 14 jours ; aucun journal d’accès HTTP."
